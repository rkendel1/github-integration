{
  "name": "@rkendel1/github-integration",
  "version": "1.0.0",
  "description": "Platform-native standalone GitHub integration boundary",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "!dist/src/server.*",
    "!dist/src/architecture-audit.*",
    ".flow",
    "README.md",
    "docs/package.md",
    "docs/consumer.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run dependency-report && npm test && npm run package:check",
    "package": "npm run build && node scripts/package.mjs",
    "package:check": "npm run build && node scripts/package-check.mjs",
    "start": "node dist/src/server.js",
    "dependency-report": "npm run build && node scripts/dependency-report.mjs"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/rkendel1/github-integration"
  },
  "keywords": [
    "github",
    "integration",
    "appport",
    "authboundry",
    "feltdb"
  ],
  "license": "ISC",
  "dependencies": {
    "@appport/appboundry": "1.0.10",
    "@appport/sdk": "1.1.18",
    "@appport/services": "0.4.0",
    "@authboundry/core": "1.15.1",
    "@feltdb/core": "0.11.4",
    "@octokit/rest": "22.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
