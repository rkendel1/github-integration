flow_version 1

app github_integration {
  collection GitHubConnection {
    credential_reference: json
    auth_mechanism: text
    status: text
    tenant_id: text
    application_id: text
    environment: text
    provider: text
    created_at: datetime
    updated_at: datetime
    index tenant_id using hash(tenant_id)
    index status using hash(status)
  }

  collection GitHubInstallation {
    connection_id: text
    installation_id: integer
    account_login: text
    account_type: text
    target_type: text
    created_at: datetime
    updated_at: datetime
    index connection_id using hash(connection_id)
    index installation_id using hash(installation_id)
  }

  collection GitHubRepository {
    connection_id: text
    owner: text
    name: text
    node_id: text
    default_branch: text
    private: boolean
    archived: boolean
    updated_at: datetime
    index connection_id using hash(connection_id)
    index owner using hash(owner)
  }

  collection GitHubWebhookEvent {
    delivery_id: text
    event_name: text
    action: text
    connection_id: text
    repository_full_name: text
    status: text
    signature_valid: boolean
    received_at: datetime
    processed_at: datetime
    index delivery_id using hash(delivery_id)
    index event_name using hash(event_name)
  }

  collection GitHubOperation {
    capability: text
    principal_id: text
    tenant_id: text
    application_id: text
    connection_id: text
    resource_type: text
    resource_id: text
    status: text
    created_at: datetime
    updated_at: datetime
    index capability using hash(capability)
    index connection_id using hash(connection_id)
  }

  collection GitHubEvidence {
    operation_id: text
    capability: text
    principal_id: text
    tenant_id: text
    application_id: text
    result: text
    github_resource: json
    created_at: datetime
    index operation_id using hash(operation_id)
  }

  capability GitHubOrganizationRead {
    visibility public
    operation github.organization.read
    grant github.organization.read
  }

  capability GitHubRepositoryRead {
    visibility public
    operation github.repository.read
    grant github.repository.read
  }

  capability GitHubBranchRead {
    visibility public
    operation github.branch.read
    grant github.branch.read
  }

  capability GitHubBranchCreate {
    visibility public
    operation github.branch.create
    grant github.branch.create
  }

  capability GitHubCommitRead {
    visibility public
    operation github.commit.read
    grant github.commit.read
  }

  capability GitHubIssueRead {
    visibility public
    operation github.issue.read
    grant github.issue.read
  }

  capability GitHubIssueCreate {
    visibility public
    operation github.issue.create
    grant github.issue.create
  }

  capability GitHubIssueUpdate {
    visibility public
    operation github.issue.update
    grant github.issue.update
  }

  capability GitHubIssueComment {
    visibility public
    operation github.issue.comment
    grant github.issue.comment
  }

  capability GitHubPullRequestRead {
    visibility public
    operation github.pull_request.read
    grant github.pull_request.read
  }

  capability GitHubPullRequestCreate {
    visibility public
    operation github.pull_request.create
    grant github.pull_request.create
  }

  capability GitHubPullRequestUpdate {
    visibility public
    operation github.pull_request.update
    grant github.pull_request.update
  }

  capability GitHubPullRequestComment {
    visibility public
    operation github.pull_request.comment
    grant github.pull_request.comment
  }

  capability GitHubPullRequestReview {
    visibility public
    operation github.pull_request.review
    grant github.pull_request.review
  }

  capability GitHubPullRequestMerge {
    visibility public
    operation github.pull_request.merge
    grant github.pull_request.merge
  }
}
